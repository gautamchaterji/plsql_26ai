cells:
  - kind: 2
    value: "create or replace function get_brick_by_id (\r

      \   id bricks.brick_id%type\r

      ) return bricks%rowtype is\r

      \   result bricks%rowtype;\r

      begin\r

      \   select *\r

      \     into result\r

      \     from bricks\r

      \    where brick_id = id;\r

      \   return result;\r

      end;"
    languageId: oracle-sql
  - kind: 2
    value: "begin\r

      \   -- Example usage of the function\r

      \   declare\r

      \      brick_record bricks%rowtype;\r

      \   begin\r

      \      brick_record := get_brick_by_id(1);\r

      \      for col in (\r

      \         select *\r

      \           from bricks\r

      \          where brick_id = brick_record.brick_id\r

      \      ) loop\r

      \         dbms_output.put_line('Brick ID: '\r

      \                              || col.brick_id\r

      \                              || ', Weight: ' || col.weight);\r

      \      end loop;\r

      \   end;\r

      end;"
    languageId: oracle-sql
  - kind: 2
    value: "declare\r

      \   var bricks%rowtype;\r

      begin\r

      \   var := get_brick_by_id(3);\r

      \   dbms_output.put_line('Brick ID: '\r

      \                        || var.brick_id\r

      \                        || ', Colour: '\r

      \                        || var.colour\r

      \                        || ', Weight: ' || var.weight);\r

      end;\r

      /"
    languageId: oracle-sql
  - kind: 2
    value: execute dbms_output.put_line(get_brick_by_id(3).colour);
    languageId: oracle-sql
  - kind: 2
    value: "create or replace function get_brick_colour(p_brick_id in number) return
      varchar2 is\r

      \   v_colour bricks.colour%type;\r

      begin\r

      \   select colour into v_colour\r

      \     from bricks\r

      \    where brick_id = p_brick_id;\r

      \   return v_colour;\r

      \   exception\r

      \      when no_data_found then\r

      \         return null;\r

      end get_brick_colour;"
    languageId: oracle-sql
  - kind: 2
    value: "select brick_id, get_brick_colour(brick_id) as colour\r

      \  from bricks;"
    languageId: oracle-sql
  - kind: 2
    value: exec dbms_output.put_line(get_brick_colour(5));
    languageId: oracle-sql
